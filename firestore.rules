rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Product Catalog
    match /products/{productId} {
      function isValidProduct(data) {
        return data.keys().hasAll(['name', 'price', 'category']) 
          && data.keys().size() == 3
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.price is number && data.price >= 0
          && data.category is string && data.category.size() > 0;
      }

      allow read: if true;
      allow create: if isValidProduct(request.resource.data);
      allow update: if isValidProduct(request.resource.data);
      allow delete: if true;
    }

    // Accounts
    match /accounts/{accountId} {
      function isValidAccount(data) {
        return data.keys().hasAll(['name', 'status', 'total', 'createdAt']) 
          && data.keys().size() >= 4
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.status in ['open', 'closed']
          && data.total is number 
          && data.createdAt is number
          && (!('items' in data) || data.items is list);
      }

      allow read: if true;
      allow create: if isValidAccount(request.resource.data);
      allow update: if isValidAccount(request.resource.data);
      allow delete: if true;

      // Items in Account
      match /items/{itemId} {
        function isValidItem(data) {
          return data.keys().hasAll(['productId', 'name', 'price', 'quantity'])
            && data.keys().size() == 4
            && data.name is string 
            && data.price is number 
            && data.quantity is number 
            && data.quantity >= 0;
        }

        allow read: if true;
        allow create: if isValidItem(request.resource.data);
        allow update: if isValidItem(request.resource.data);
        allow delete: if true;
      }
    }
  }
}
